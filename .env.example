# Copy this file to .env before running `docker compose up`.
# Never commit the real .env file.

# --- Core services ---------------------------------------------------
DATABASE_URL=postgresql+asyncpg://eventmesh:eventmesh@postgres:5432/eventmesh
REDIS_URL=redis://redis:6379/0

# --- Security ----------------------------------------------------------
# 32+ byte key used to encrypt webhook secrets at rest. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_ENCRYPTION_KEY=local-dev-only-change-me-32bytes!!

# --- Timeouts (seconds) ------------------------------------------------
HTTP_CONNECT_TIMEOUT_SECONDS=2.0
HTTP_READ_TIMEOUT_SECONDS=5.0
HTTP_WRITE_TIMEOUT_SECONDS=5.0
HTTP_TOTAL_TIMEOUT_SECONDS=10.0
MAX_REDIRECTS=0

# --- Payload limits ------------------------------------------------------
MAX_EVENT_PAYLOAD_BYTES=262144
MAX_ENDPOINT_URL_LENGTH=2048
MAX_EVENT_TYPE_LENGTH=255

# --- Retry / backoff -----------------------------------------------------
RETRY_BASE_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=32.0
RETRY_MAX_ATTEMPTS=6
RETRY_JITTER_RATIO=0.2

# --- Circuit breaker -------------------------------------------------------
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_DURATION_SECONDS=30.0
CIRCUIT_HALF_OPEN_MAX_REQUESTS=1

# --- Worker ----------------------------------------------------------------
WORKER_CONCURRENCY=20
WORKER_CONSUMER_GROUP=eventmesh-delivery-group
WORKER_STREAM_NAME=eventmesh:deliveries
WORKER_BATCH_SIZE=10
WORKER_BLOCK_MS=5000
WORKER_STALE_CLAIM_IDLE_MS=60000
WORKER_GRACEFUL_SHUTDOWN_SECONDS=30

# --- Rate limiting (requests/minute per tenant plan) -------------------------
RATE_LIMIT_FREE_PER_MINUTE=100
RATE_LIMIT_PRO_PER_MINUTE=1000
RATE_LIMIT_ENTERPRISE_PER_MINUTE=10000

# --- Retention (days) ---------------------------------------------------------
RETENTION_EVENTS_DAYS=30
RETENTION_DELIVERIES_DAYS=30
RETENTION_DLQ_DAYS=90
IDEMPOTENCY_KEY_TTL_DAYS=7

# --- Misc ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
SERVICE_NAME=eventmesh
